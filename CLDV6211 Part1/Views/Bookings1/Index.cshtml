@model IEnumerable<CLDV6211_Part1.Models.BookingViewModel>

@{
    ViewData["Title"] = "Advanced Booking Search";
}

<h2>Bookings Management</h2>

<div class="card mb-4 p-3 shadow-sm">
    <form asp-action="Index" method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Search Name/ID</label>
                <input type="text" name="searchString" class="form-control" placeholder="Search..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">Event Type</label>
                <select name="eventType" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var type in ViewBag.EventTypes as List<string>)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Start Date</label>
                <input type="date" name="startDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">End Date</label>
                <input type="date" name="endDate" class="form-control" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 mb-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </div>
    </form>
</div>

@if (TempData["Alert"] != null)
{
    <div class="alert alert-danger">
        @TempData["Alert"]
    </div>
}

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>Booking ID</th>
            <th>Venue</th>
            <th>Event</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Specialist</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BookingID</td>
                <td>@item.VenueName</td>
                <td>@item.EventName</td>
                <td>@item.StartDate.ToShortDateString()</td>
                <td>@item.EndDate.ToShortDateString()</td>
                <td>@item.SpecialistName</td>
            </tr>
        }
    </tbody>
</table>